DATABASE_URL=
BETTER_AUTH_SECRET=
# Optional on Vercel (defaults to the production domain). Locally: http://localhost:3000
BETTER_AUTH_URL=
ADMIN_EMAILS=
# Optional: set by the Vercel Blob integration. Without it, uploads go to public/uploads (dev only).
BLOB_READ_WRITE_TOKEN=
# Optional: real e-mail delivery through Resend. Without both, e-mails are only
# stored in the outbox (/admin/epost) and sign-in uses passwords.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
